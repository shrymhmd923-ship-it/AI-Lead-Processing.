    {
      "parameters": {
        "jsCode": "\nconst raw = $input.first().json.ai_analysis;\n\nif (!raw) {\n  throw new Error(\"No AI analysis was returned.\");\n}\n\nconst cleaned = raw\n  .replace(/```json/gi, \"\")\n  .replace(/```/g, \"\")\n  .trim();\n\nconst result = JSON.parse(cleaned);\n\nconst lead = $(\"Edit Fields\").first().json;\n\nreturn [\n  {\n    json: {\n      name: lead.name,\n      email: lead.email,\n      company: lead.company,\n      message: lead.message,\n      lead_quality: result.lead_quality,\n      priority: result.priority,\n      reason: result.reason,\n      recommended_action: result.recommended_action\n    }\n  }\n];\n"
      },
